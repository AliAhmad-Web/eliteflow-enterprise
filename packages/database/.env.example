# PostgreSQL connection string (Supabase or local)
# Direct connection (migrations):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/enterprise_bms?schema=public"
#
# Supabase pooled connection (application runtime):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Supabase direct connection (migrations — use port 5432):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_bms?schema=public"
# Required when schema.prisma declares directUrl. Prefer Supabase direct host for migrations:
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/enterprise_bms?schema=public"

# Seed configuration (development only)
SEED_DEMO_PASSWORD="Password123!"
