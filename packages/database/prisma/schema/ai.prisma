// =============================================================================
// AI — Conversations, messages, generated documents
// =============================================================================

model AiConversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(200)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User        @relation("AiConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  memoryRecords AiMemoryRecord[]

  @@index([userId, deletedAt])
  @@index([updatedAt])
  @@index([title])
  @@map("ai_conversations")
}

model AiMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String       @db.Text
  mode           AiAssistMode @default(ASK)
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiDocument {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  title       String           @db.VarChar(200)
  type        AiDocumentType
  prompt      String           @db.Text
  content     String           @db.Text
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  user      User  @relation("AiDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AiDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@index([type])
  @@index([updatedAt])
  @@index([title])
  @@map("ai_documents")
}

/// Persistent Enterprise AI Memory records (structured summaries only).
model AiMemoryRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  conversationId     String?   @map("conversation_id") @db.Uuid
  memoryKey          String    @map("memory_key") @db.VarChar(128)
  type               String    @db.VarChar(32)
  scope              String    @db.VarChar(32)
  priority           String    @db.VarChar(16)
  summary            String    @db.VarChar(500)
  source             String    @db.VarChar(64)
  tagsJson           String    @default("[]") @map("tags_json") @db.Text
  permissionKeysJson String    @default("[]") @map("permission_keys_json") @db.Text
  recency            Float     @default(0.5)
  expiresAt          DateTime? @map("expires_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user         User            @relation("AiMemoryRecordOwner", fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([userId, memoryKey])
  @@index([userId, deletedAt, type])
  @@index([userId, conversationId, deletedAt])
  @@index([expiresAt])
  @@index([updatedAt])
  @@map("ai_memory_records")
}
