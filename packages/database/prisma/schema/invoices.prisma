// =============================================================================
// Invoices — Billing, line items, payment history
// =============================================================================

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  clientId       String        @map("client_id") @db.Uuid
  projectId      String?       @map("project_id") @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  currency       String        @default("USD") @db.VarChar(3)
  taxRate        Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  notes          String?       @db.Text
  /// Optional Stripe invoice id when synchronized from Stripe billing.
  stripeInvoiceId String?      @unique @map("stripe_invoice_id") @db.VarChar(255)
  createdById    String?       @map("created_by_id") @db.Uuid
  updatedById    String?       @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  client         Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project        Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User?                   @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?                   @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  paymentHistory InvoicePaymentHistory[]

  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([createdById])
  @@index([createdAt])
  @@index([total])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortOrder])
  @@map("invoice_items")
}

model InvoicePaymentHistory {
  id        String        @id @default(uuid()) @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  status    InvoiceStatus
  amount    Decimal?      @db.Decimal(14, 2)
  note      String?       @db.VarChar(500)
  actorId   String?       @map("actor_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  actor   User?   @relation("InvoicePaymentActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([actorId])
  @@map("invoice_payment_history")
}
