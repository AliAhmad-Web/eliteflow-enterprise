// =============================================================================
// Public API v1 — inbound API keys (machine credentials)
// =============================================================================
// Secrets are stored hashed only (argon2id). Raw key shown once at creation.
// Optional clientId binds the key to a single company for isolation.
// =============================================================================

model PublicApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  /// Indexed lookup prefix (e.g. "ef_live_xxxxxxxx") — never the full secret.
  keyPrefix   String    @map("key_prefix") @db.VarChar(32)
  /// Argon2id hash of the full API key secret.
  keyHash     String    @map("key_hash") @db.VarChar(255)
  /// Granted scopes (e.g. public:read, clients:read).
  scopes      String[]  @db.VarChar(64)
  ownerUserId String    @map("owner_user_id") @db.Uuid
  /// When set, requests are limited to this client/company only.
  clientId    String?   @map("client_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner  User   @relation("PublicApiKeyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  client Client? @relation("PublicApiKeyClient", fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([keyPrefix])
  @@index([ownerUserId, createdAt])
  @@index([clientId])
  @@index([revokedAt])
  @@index([expiresAt])
  @@map("public_api_keys")
}
