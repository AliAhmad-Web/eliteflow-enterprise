// =============================================================================
// Clients — CRM company / contact records
// =============================================================================

/// Business client managed by Admins and viewable by Employees.
model Client {
  id           String       @id @default(uuid()) @db.Uuid
  companyName  String       @map("company_name") @db.VarChar(200)
  contactName  String       @map("contact_name") @db.VarChar(200)
  email        String       @db.VarChar(320)
  phone        String?      @db.VarChar(40)
  website      String?      @db.VarChar(2048)
  addressLine1 String?      @map("address_line1") @db.VarChar(255)
  city         String?      @db.VarChar(100)
  country      String?      @db.VarChar(100)
  status       ClientStatus @default(LEAD)
  /// Sales pipeline stage — primarily for LEAD records; WON/LOST align with ACTIVE/INACTIVE.
  pipelineStage ClientPipelineStage? @map("pipeline_stage")
  notes        String?      @db.Text
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  createdBy User? @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  portalUsers User[] @relation("UserCompany")
  projects    Project[]
  invoices    Invoice[]
  quotes      Quote[]
  payments    Payment[]
  folders     Folder[]
  managedFiles ManagedFile[]
  fileShares  FileShare[]
  calendarEvents CalendarEvent[]
  whiteboards    Whiteboard[]
  activities  ClientActivity[]
  publicApiKeys PublicApiKey[] @relation("PublicApiKeyClient")
  customerRequests CustomerRequest[]

  @@index([email])
  @@index([companyName])
  @@index([status])
  @@index([pipelineStage])
  @@index([deletedAt])
  @@index([createdById])
  @@index([createdAt])
  @@map("clients")
}

/// CRM activity timeline against a client / lead (notes, calls, meetings, etc.).
model ClientActivity {
  id          String             @id @default(uuid()) @db.Uuid
  clientId    String             @map("client_id") @db.Uuid
  type        ClientActivityType @default(NOTE)
  title       String             @db.VarChar(200)
  body        String?            @db.VarChar(5000)
  occurredAt  DateTime           @default(now()) @map("occurred_at")
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ClientActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, occurredAt])
  @@index([type])
  @@index([deletedAt])
  @@index([createdById])
  @@map("client_activities")
}
