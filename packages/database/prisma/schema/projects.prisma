// =============================================================================
// Projects — Delivery tracking, team, milestones, attachments
// =============================================================================

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(200)
  description String?         @db.Text
  clientId    String?         @map("client_id") @db.Uuid
  status      ProjectStatus   @default(NOT_STARTED)
  priority    ProjectPriority @default(MEDIUM)
  startDate   DateTime?       @map("start_date") @db.Date
  dueDate     DateTime?       @map("due_date") @db.Date
  progress    Int             @default(0)
  budget      Decimal?        @db.Decimal(14, 2)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  client      Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  milestones  ProjectMilestone[]
  attachments ProjectAttachment[]
  tasks       Task[]
  invoices    Invoice[]
  folders     Folder[]
  managedFiles ManagedFile[]
  calendarEvents CalendarEvent[]
  whiteboards    Whiteboard[]
  customerRequestTargets    CustomerRequest[] @relation("CustomerRequestTargetProject")
  customerRequestsConverted CustomerRequest[] @relation("CustomerRequestConvertedProject")

  @@index([name])
  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([createdById])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleLabel  String?  @map("role_label") @db.VarChar(100)
  assignedAt DateTime @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectMilestone {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String          @db.VarChar(200)
  description String?         @db.Text
  dueDate     DateTime?       @map("due_date") @db.Date
  status      MilestoneStatus @default(PENDING)
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@index([dueDate])
  @@map("project_milestones")
}

model ProjectAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.VarChar(2048)
  mimeType     String?  @map("mime_type") @db.VarChar(120)
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedById])
  @@map("project_attachments")
}
