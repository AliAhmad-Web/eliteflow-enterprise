// =============================================================================
// Enterprise Business Management — Prisma Schema Entry Point
// =============================================================================
// Multi-file schema: generator + datasource live here.
// Models are organized by domain in prisma/schema/
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  // native = local/dev; rhel = Vercel Node serverless (Amazon Linux)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: use pooler for runtime (DATABASE_URL) and direct PG for migrations (DIRECT_URL).
  // Never commit real credentials. If direct host is unreachable, DIRECT_URL may temporarily
  // point at the session-mode pooler used for migrate deploy.
  directUrl = env("DIRECT_URL")
}
