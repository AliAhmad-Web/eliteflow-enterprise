# NEXT_PUBLIC_AI_DOCS_AUTOSAVE=false
# NEXT_PUBLIC_AI_DOCS_TEMPLATE_PRESETS=false
# NEXT_PUBLIC_AI_DOCS_DEEP_LINK_FETCH=false
# NEXT_PUBLIC_AI_DOCS_EXPORT_ENHANCED=false
# NEXT_PUBLIC_AI_DOCS_CREATE_MANUAL=false
# NEXT_PUBLIC_AI_DOCS_VERSION_HISTORY=false
# NEXT_PUBLIC_AI_DOCS_SHARING=false
# NEXT_PUBLIC_AI_DOCS_DRAFTS_APPROVAL=false
# NEXT_PUBLIC_AI_DOCS_COMMENTS=false
# NEXT_PUBLIC_AI_DOCS_REGENERATE=false

# AI Analytics / Reports feature flags (Task 1.3) — all default OFF when unset.
# Docs: apps/web/src/features/reports/feature-flags/AI_ANALYTICS_FLAGS.md
# NEXT_PUBLIC_AI_ANALYTICS_ENTERPRISE_SHELL=false
# NEXT_PUBLIC_AI_ANALYTICS_ENHANCED_KPIS=false
# NEXT_PUBLIC_AI_ANALYTICS_INSIGHT_CARDS=false
# NEXT_PUBLIC_AI_ANALYTICS_BUSINESS_SUMMARY=false
# NEXT_PUBLIC_AI_ANALYTICS_TREND_ENHANCEMENTS=false
# NEXT_PUBLIC_AI_ANALYTICS_RECOMMENDATION_CARDS=false
# NEXT_PUBLIC_AI_ANALYTICS_ACTIVITY_TIMELINE=false
# NEXT_PUBLIC_AI_ANALYTICS_ADVANCED_FILTERS=false
# NEXT_PUBLIC_AI_ANALYTICS_REFRESH=false
# NEXT_PUBLIC_AI_ANALYTICS_SKELETONS=false
# NEXT_PUBLIC_AI_ANALYTICS_ENHANCED_FEEDBACK=false

# Performance feature flags (Task 1.4) — all default OFF when unset.
# Docs: apps/web/src/features/performance/feature-flags/PERFORMANCE_FLAGS.md
