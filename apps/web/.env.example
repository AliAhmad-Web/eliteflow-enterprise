# NEXT_PUBLIC_EMAIL_AI_COMMAND_PALETTE=false

# --- Production provider integrations (Phase 7 architecture — env only) ---
# Voice: browser Web Speech STT/TTS (no server secret required for browser mode)
# VOICE_PROVIDER / NEXT_PUBLIC_VOICE_PROVIDER: browser | web_speech | none
NEXT_PUBLIC_VOICE_PROVIDER=browser
NEXT_PUBLIC_VOICE_LANG=en-US
# Optional reserved for future cloud STT (do not put real secrets in NEXT_PUBLIC_*)
# NEXT_PUBLIC_VOICE_API_KEY=

# WhatsApp UI readiness hint (phone number ID is not a secret; token stays on API)
# NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=
# NEXT_PUBLIC_WHATSAPP_READY=true

# Email UI readiness hint (delivery uses API EMAIL_PROVIDER / SMTP_* / RESEND_*)
# Set when API email transport is configured — shows Connected in Notification Center
NEXT_PUBLIC_EMAIL_READY=true
# Optional: NEXT_PUBLIC_EMAIL_PROVIDER=smtp

