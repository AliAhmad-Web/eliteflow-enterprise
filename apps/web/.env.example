# NEXT_PUBLIC_COMMUNICATION_AI_ASSISTANT=true
# NEXT_PUBLIC_COMMUNICATION_SPEECH_UI=false
# NEXT_PUBLIC_COMMUNICATION_VOICE_ACTIONS=false
# NEXT_PUBLIC_COMMUNICATION_WHATSAPP=false
# NEXT_PUBLIC_COMMUNICATION_WHATSAPP_QUEUE=false
