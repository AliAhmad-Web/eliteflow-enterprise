# NEXT_PUBLIC_COMMUNICATION_EMAIL_AI=true
# NEXT_PUBLIC_COMMUNICATION_EMAIL_THREADS=false
# NEXT_PUBLIC_COMMUNICATION_EMAIL_VOICE=false
# NEXT_PUBLIC_COMMUNICATION_EMAIL_SEARCH=false
