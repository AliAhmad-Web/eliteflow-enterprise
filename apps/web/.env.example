# EliteFlow Web — copy to .env.local for local development
# Never commit real secrets.

# Local development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (Vercel) — set these in the Vercel project env UI:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_APP_URL=https://app.your-domain.com

# Supabase (Auth / OAuth client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Google reCAPTCHA v3 site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# AI Assistant UI feature flags (Wave W0) — all default OFF when unset.
# Docs: apps/web/src/features/ai/feature-flags/README.md
# NEXT_PUBLIC_AI_UI_ENTERPRISE_SHELL=false
# NEXT_PUBLIC_AI_UI_STREAM_CONTROLS=false
# NEXT_PUBLIC_AI_UI_ENHANCED_FEEDBACK=false
# NEXT_PUBLIC_AI_UI_SKELETONS=false
# NEXT_PUBLIC_AI_UI_SHORTCUTS=false
# NEXT_PUBLIC_AI_UI_PROVIDER_BADGE=false
# NEXT_PUBLIC_AI_UI_CONTEXT_INDICATORS=false
# NEXT_PUBLIC_AI_UI_MOBILE_HISTORY_SHEET=false
# NEXT_PUBLIC_AI_UI_HISTORY_PAGINATION=false
# NEXT_PUBLIC_AI_UI_CONVERSATION_ORG=false

# AI Documents feature flags (Task 1.2) — all default OFF when unset.
# Docs: apps/web/src/features/ai/feature-flags/AI_DOCS_FLAGS.md
# NEXT_PUBLIC_AI_DOCS_ENTERPRISE_SHELL=false
# NEXT_PUBLIC_AI_DOCS_SKELETONS=false
# NEXT_PUBLIC_AI_DOCS_ENHANCED_FEEDBACK=false
