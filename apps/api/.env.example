NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_bms?schema=public"
# Direct (non-pooler) Postgres URL for Prisma migrations. On Supabase:
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/enterprise_bms?schema=public"

JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_ISSUER="enterprise-bms-api"
JWT_AUDIENCE="enterprise-bms-web"

# Local development only — production MUST use HTTPS web origins (no localhost, no http://)
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
WEB_APP_URL="http://localhost:3000"
APP_URL="http://localhost:4000"
API_PUBLIC_URL="http://localhost:4000"

# Production examples (set on the API host — never use localhost):
# NODE_ENV=production
# CORS_ORIGIN="https://app.your-domain.com"
# FRONTEND_URL="https://app.your-domain.com"
# WEB_APP_URL="https://app.your-domain.com"
# APP_URL="https://api.your-domain.com"
# API_PUBLIC_URL="https://api.your-domain.com"
# GOOGLE_OAUTH_REDIRECT_URI="https://api.your-domain.com/api/v1/integrations/oauth/callback/google"
# GITHUB_OAUTH_REDIRECT_URI="https://api.your-domain.com/api/v1/integrations/oauth/callback/github"

# Auth emails (verification, password reset, OTP):
# Railway blocks outbound SMTP — prefer GitHub Actions relay or Gmail API.
#   GITHUB_EMAIL_RELAY_TOKEN=ghp_...
#   GITHUB_EMAIL_RELAY_REPO=owner/repo
# Direct SMTP (local/dev only on networks that allow port 587):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
GITHUB_EMAIL_RELAY_TOKEN=""
GITHUB_EMAIL_RELAY_REPO=""
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
GMAIL_USER=""
# Resend optional; needs verified custom domain for arbitrary inboxes.
RESEND_API_KEY=""
EMAIL_FROM="EliteFlow <you@gmail.com>"
APP_NAME="EliteFlow"
# Prefer a transport when multiple are configured: auto | smtp | resend | gmail_api | github_relay
EMAIL_PROVIDER="auto"

# Task 7.3 Email Workspace API mirrors (default OFF)
# COMMUNICATION_EMAIL_WORKSPACE=false
# COMMUNICATION_EMAIL_AI=false
# COMMUNICATION_EMAIL_VOICE=false
# COMMUNICATION_EMAIL_SCHEDULE=false

# WhatsApp Business Cloud API (Meta) — used by NotificationQueue WHATSAPP channel
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Optional overrides:
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com

# Voice provider (server mirror / ops docs). Web uses NEXT_PUBLIC_VOICE_PROVIDER.
# VOICE_PROVIDER=browser
# VOICE_API_KEY=

# AI providers (Mock is used when no live key is set)
# Priority: GEMINI_API_KEY → OPENAI_API_KEY → mock
# Optional force: AI_PROVIDER=gemini|openai|mock
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Supabase Auth (required for Google/GitHub OAuth)
SUPABASE_URL="https://your-project.supabase.co"
# Real service_role JWT or sb_secret_… from Supabase Dashboard → Settings → API
# NEVER put this in NEXT_PUBLIC_* or frontend code. Do not use placeholder values.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
# Optional HS256 fallback when Auth API/JWKS are unreachable
SUPABASE_JWT_SECRET=""

# File Manager storage
# - local  → disk (default for development; always safe without service role)
# - auto   → Supabase Storage when a real service-role key is set, else local
# - supabase → requires real SUPABASE_SERVICE_ROLE_KEY; falls back to local if unusable
STORAGE_PROVIDER="local"
# After adding a real service-role key:
# STORAGE_PROVIDER="supabase"
# or: STORAGE_PROVIDER="auto"
LOCAL_STORAGE_PATH=""
# Must match the Storage bucket created in Supabase Dashboard (File Manager default)
SUPABASE_STORAGE_BUCKET="files"
FILE_MAX_SIZE_BYTES="26214400"

# Redis (production multi-instance — rate limit, CSRF, AI confirmation/budget, devices)
# REDIS_URL="redis://default:PASSWORD@host:6379"
# RATE_LIMIT_REDIS_URL="redis://default:PASSWORD@host:6379"
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_FAIL_OPEN=false

# Google reCAPTCHA v3 (optional in development — skipped when unset; REQUIRED in production)
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"

# Virus scan: local/dev may use noop; production should use clamav or cloud
VIRUS_SCAN_ENABLED="false"
VIRUS_SCAN_ENGINE="noop"
# VIRUS_SCAN_ENABLED="true"
# VIRUS_SCAN_PROVIDER="clamav"
# CLAMAV_HOST="127.0.0.1"
# CLAMAV_PORT="3310"
# VIRUS_SCAN_FAIL_CLOSED="true"
# VIRUS_SCAN_CLOUD_URL=""
# VIRUS_SCAN_CLOUD_API_KEY=""

# Enterprise encryption (production REQUIRED). Generate a 32-byte base64 secret.
ENTERPRISE_ENCRYPTION_KEY=""
# ENTERPRISE_ENCRYPTION_KEY_PREVIOUS=""

# Phase 18 — encrypt integration API keys (falls back to JWT_SECRET in development)
SETTINGS_ENCRYPTION_KEY=""

# Phase 19.2 — Gmail / Google Calendar / GitHub OAuth (production)
# All values required for live Connect. No mock mode.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/integrations/oauth/callback/google"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/integrations/oauth/callback/github"
# Required in production; falls back to JWT_SECRET only in non-production
INTEGRATIONS_OAUTH_STATE_SECRET=""

# ---------------------------------------------------------------------------
# Enterprise SIEM Integration (outbound security event export) — default OFF
# Never put SIEM secrets in NEXT_PUBLIC_* or frontend code.
# Do NOT enable in production until a real HTTPS endpoint + credential exist.
# ---------------------------------------------------------------------------
SECURITY_SIEM_ENABLED="false"
# Alias: SIEM_ENABLED=false
# SIEM_PROVIDERS="GENERIC_WEBHOOK"
# SIEM_TENANT_ID=""
# SIEM_BATCH_SIZE=25
# SIEM_MAX_QUEUE_SIZE=2000
# SIEM_MAX_RETRIES=5
# SIEM_BASE_BACKOFF_MS=1000
# SIEM_MAX_BACKOFF_MS=60000
# SIEM_FLUSH_INTERVAL_MS=5000
# SIEM_REQUEST_TIMEOUT_MS=10000
# SIEM_CIRCUIT_FAILURE_THRESHOLD=5
# SIEM_CIRCUIT_OPEN_MS=30000
# SIEM_WEBHOOK_SIGNING_SECRET=""
#
# Per-provider (prefix SIEM_<PROVIDER>_…):
# SIEM_GENERIC_WEBHOOK_ENABLED=false
# SIEM_GENERIC_WEBHOOK_ENDPOINT="https://siem.example.com/ingest"
# SIEM_GENERIC_WEBHOOK_AUTH_MODE="BEARER"
# SIEM_GENERIC_WEBHOOK_BEARER_TOKEN=""
# SIEM_GENERIC_WEBHOOK_API_KEY=""
# SIEM_GENERIC_WEBHOOK_SIGNING_SECRET=""
# SIEM_GENERIC_WEBHOOK_TRANSPORT="HTTPS_WEBHOOK"
#
# Production free-tier target (Axiom Personal → GENERIC_WEBHOOK):
# SECURITY_SIEM_ENABLED=true
# SIEM_PROVIDERS=GENERIC_WEBHOOK
# SIEM_GENERIC_WEBHOOK_ENDPOINT="https://us-east-1.aws.edge.axiom.co/v1/ingest/axiom-audit?timestamp-field=timestamp"
# Prefer dedicated dataset eliteflow-siem once created in Axiom UI.
# SIEM_GENERIC_WEBHOOK_AUTH_MODE=BEARER
# SIEM_GENERIC_WEBHOOK_BEARER_TOKEN=""
# SIEM_REQUEST_TIMEOUT_MS=10000
# SIEM_MAX_RETRIES=5
# See docs/security/SIEM_PRODUCTION.md
#
# Note: Better Stack was preferred first but signup may be temporarily unavailable.
#
# Splunk HEC example:
# SIEM_PROVIDERS="SPLUNK"
# SIEM_SPLUNK_ENDPOINT="https://http-inputs.example.splunkcloud.com/services/collector"
# SIEM_SPLUNK_HEC_TOKEN=""
# SIEM_SPLUNK_AUTH_MODE="API_KEY"
# SIEM_SPLUNK_TRANSPORT="REST_API"
