NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_bms?schema=public"

JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_ISSUER="enterprise-bms-api"
JWT_AUDIENCE="enterprise-bms-web"

# Local development only — production MUST use HTTPS web origins (no localhost, no http://)
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Production examples (set on the API host — never use localhost):
# NODE_ENV=production
# CORS_ORIGIN="https://app.your-domain.com"
# FRONTEND_URL="https://app.your-domain.com"
# APP_URL="https://api.your-domain.com"
# GOOGLE_OAUTH_REDIRECT_URI="https://api.your-domain.com/api/v1/integrations/oauth/callback/google"
# GITHUB_OAUTH_REDIRECT_URI="https://api.your-domain.com/api/v1/integrations/oauth/callback/github"

# Auth emails (verification, password reset, OTP):
# Railway blocks outbound SMTP — prefer GitHub Actions relay or Gmail API.
#   GITHUB_EMAIL_RELAY_TOKEN=ghp_...
#   GITHUB_EMAIL_RELAY_REPO=owner/repo
# Direct SMTP (local/dev only on networks that allow port 587):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
GITHUB_EMAIL_RELAY_TOKEN=""
GITHUB_EMAIL_RELAY_REPO=""
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
GMAIL_USER=""
# Resend optional; needs verified custom domain for arbitrary inboxes.
RESEND_API_KEY=""
EMAIL_FROM="EliteFlow <you@gmail.com>"
APP_NAME="EliteFlow"

# AI providers (Mock is used when no live key is set)
# Priority: GEMINI_API_KEY → OPENAI_API_KEY → mock
# Optional force: AI_PROVIDER=gemini|openai|mock
AI_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Supabase Auth (required for Google/GitHub OAuth)
SUPABASE_URL="https://your-project.supabase.co"
# Prefer new secret key, or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-sb-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
# Optional HS256 fallback when Auth API/JWKS are unreachable
SUPABASE_JWT_SECRET=""

# File Manager storage (local for development, supabase for production)
STORAGE_PROVIDER="local"
# Production: STORAGE_PROVIDER="supabase"
LOCAL_STORAGE_PATH=""
SUPABASE_STORAGE_BUCKET="files"
FILE_MAX_SIZE_BYTES="26214400"

# Google reCAPTCHA v3 (optional in development — skipped when unset)
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"

# Virus scan engine: noop | clamav | cloud (prepare-only architecture)
VIRUS_SCAN_ENGINE="noop"

# Phase 18 — encrypt integration API keys (falls back to JWT_SECRET in development)
SETTINGS_ENCRYPTION_KEY=""

# Phase 19.2 — Gmail / Google Calendar / GitHub OAuth (production)
# All values required for live Connect. No mock mode.
APP_URL="http://localhost:4000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/integrations/oauth/callback/google"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:4000/api/v1/integrations/oauth/callback/github"
# Required in production; falls back to JWT_SECRET only in non-production
INTEGRATIONS_OAUTH_STATE_SECRET=""
