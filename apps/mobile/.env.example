# EliteFlow Mobile — copy to .env for local development
# Physical device / Expo Go: use your PC LAN IP (not localhost).
# Emulator (Android): often http://10.0.2.2:4000
# iOS Simulator / web: http://localhost:4000 is fine
EXPO_PUBLIC_API_URL=http://localhost:4000

# Production (EAS): set EXPO_PUBLIC_API_URL in Expo dashboard → Environment variables
# for the "production" environment, e.g.:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
