# EliteFlow Mobile — copy to .env for local development
# Physical device / Expo Go: use your PC LAN IP (not localhost).
# Emulator (Android): often http://10.0.2.2:4000
# iOS Simulator / web: http://localhost:4000 is fine
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional — Google reCAPTCHA v3 site key (must match API RECAPTCHA_SECRET_KEY)
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Production (EAS): also set in Expo dashboard / eas.json env:
# EXPO_PUBLIC_API_URL=https://api-production-a778.up.railway.app
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=<matching site key>
