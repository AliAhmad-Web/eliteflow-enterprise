{
  "expo": {
    "name": "EliteFlow",
    "slug": "eliteflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eliteflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eliteflow.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock EliteFlow with Face ID after signing in.",
        "NSCameraUsageDescription": "Capture photos to upload to the file manager.",
        "NSPhotoLibraryUsageDescription": "Select photos to upload to the file manager.",
        "NSMicrophoneUsageDescription": "Record voice notes for conversations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.eliteflow.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F766E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EliteFlow to access your photos for uploads.",
          "cameraPermission": "Allow EliteFlow to use the camera for uploads."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes for conversations."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "4c37822c-bb9e-4b21-98d9-7a68ca38f68e"
      }
    },
    "owner": "aliahmadwebs-team"
  }
}
