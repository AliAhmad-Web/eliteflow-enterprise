{
  "manifest_version": 3,
  "name": "EliteFlow",
  "short_name": "EliteFlow",
  "description": "EliteFlow enterprise quick access — dashboard, AI, notifications, and browser actions for the same EliteFlow platform.",
  "version": "1.0.0",
  "version_name": "1.0.0 Enterprise",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "EliteFlow",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://api-production-a778.up.railway.app/*",
    "https://eliteflow-web.vercel.app/*",
    "https://eliteflow.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"
  }
}
